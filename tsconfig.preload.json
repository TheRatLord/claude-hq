{
  // The sandboxed Electron preload cannot be type-stripped by node (Electron loads it as plain CJS text), so it is the one
  // file that is compiled: `npm run build:preload` → out/preload/preload.cjs (gitignored). electron/main.ts loads that.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023", "DOM"], "types": ["node"],
    "verbatimModuleSyntax": false, "allowImportingTsExtensions": false, "noEmit": false,
    "outDir": "out/preload", "rootDir": "electron"
  },
  "include": ["electron/preload.cts"]
}

{
  // renderer/src (browser, bundled by vite) + the shared/ modules it imports. DOM lib, vite client types, no node types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["renderer/src", "shared"],
  "exclude": ["**/*.test.ts", "node_modules"]
}

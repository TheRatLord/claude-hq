{
  "name": "claude-hq",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Valley: a cozy first-person farm valley for watching and driving your coding agents",
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "app": "npm run build && electron electron/main.ts",
    "app:demo": "npm run build && electron electron/main.ts --demo",
    "dev": "node scripts/workbench.ts",
    "build": "node scripts/workbench.ts --build",
    "shoot": "node scripts/shoot.ts",
    "bench": "node scripts/bench.ts",
    "mapviz": "node scripts/mapviz.ts",
    "audit:placement": "node scripts/placement.ts",
    "test:browser": "playwright test",
    "typecheck": "node scripts/typecheck.ts",
    "test": "node --test \"**/*.test.ts\"",
    "doctor": "node server/doctor.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.5",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.ts"
}

{
  "name": "claude-hq",
  "version": "0.1.0",
  "private": true,
  "description": "First-person 3D office visualising herdr agents",
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:hq": "node scripts/dev.ts --session hqtest",
    "build": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "node scripts/typecheck.ts",
    "serve": "vite build && node server/main.ts",
    "prestart": "vite build && npm run build:preload",
    "start": "electron --no-sandbox --ignore-gpu-blocklist --use-angle=vulkan --enable-features=Vulkan .",
    "test": "node --test \"**/*.test.ts\"",
    "shoot": "node scripts/shoot.ts",
    "review": "node scripts/review-shots.ts",
    "walktimes": "node scripts/walktimes.ts",
    "perf": "node scripts/perf.ts",
    "doctor": "node server/doctor.ts",
    "briefs": "node scripts/wp-briefs.ts",
    "briefs:check": "node scripts/wp-briefs.ts --check"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.5",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  // Behavioral tests and backend helpers; browser-library tests use the DOM types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["**/*.test.ts", "server/test", "browser-tests", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "scratch", "docs"]
}
